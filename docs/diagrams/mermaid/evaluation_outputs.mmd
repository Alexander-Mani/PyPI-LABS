%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#d9e8f5', 'primaryTextColor': '#15202b', 'primaryBorderColor': '#3f6f8c', 'lineColor': '#2f4858', 'secondaryColor': '#f4efe2', 'tertiaryColor': '#eef4ea', 'fontFamily': 'Helvetica' }}}%%
flowchart TD
    classDef service fill:#d9e8f5,stroke:#3f6f8c,stroke-width:1px,color:#15202b;
    classDef probe fill:#f6e7dd,stroke:#a66a41,stroke-width:1px,color:#15202b;
    classDef output fill:#f4efe2,stroke:#8b6f3d,stroke-width:1px,color:#15202b;

    DB[("1. Evaluation Database<br/>(Raw eval_run & eval_result rows)")]

    subgraph PROCESSING[2. Data Processing & Repair]
        direction LR
        REPAIR["Error Correction Script<br/>(Appends repair overlays)"]
        SUM["Thesis Summarizer Script<br/>(Aggregates raw + cleaned metrics)"]
    end

    MEM["Memory Probe Runs<br/>(Separate validity summaries)"]
    CUT["3. Frozen Cut Package<br/>(Locks digests, CSVs, & manifests)"]

    subgraph DELIVERABLES[4. Final Reporting]
        direction LR
        THESIS["Thesis Tables & Figures"]
        SLIDES["Defense Slides"]
        DEMO["Live Demo / Inspection"]
    end

    %% Database to Processing
    DB -.->|Source error rows| REPAIR
    REPAIR -.->|Repair overlays| SUM
    DB ===>|Raw canonical rows| SUM
    
    %% Live inspection routes
    DB --->|Recent runs| DEMO
    SUM --->|Summary views| DEMO

    %% To Frozen Cut
    SUM ===> CUT
    MEM --->|Validity data| CUT

    %% To Deliverables
    CUT ===> THESIS
    CUT ---> SLIDES

    class DB service;
    class REPAIR,MEM probe;
    class SUM,CUT,THESIS,SLIDES,DEMO output;
