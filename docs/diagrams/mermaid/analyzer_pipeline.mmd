%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#d9e8f5', 'primaryTextColor': '#15202b', 'primaryBorderColor': '#3f6f8c', 'lineColor': '#2f4858', 'secondaryColor': '#f4efe2', 'tertiaryColor': '#eef4ea', 'fontFamily': 'Helvetica' }}}%%
flowchart TD
    classDef service fill:#d9e8f5,stroke:#3f6f8c,stroke-width:1px,color:#15202b;
    classDef static fill:#eef4ea,stroke:#587246,stroke-width:1px,color:#15202b;
    classDef llm fill:#f4efe2,stroke:#8b6f3d,stroke-width:1px,color:#15202b;
    classDef output fill:#f7f8fa,stroke:#5f6b76,stroke-width:1px,color:#15202b;

    ACQ["1. Artifact Acquisition<br/>(Resolve latest stable version & download isolated archives)"]
    EXTRACT["2. Static Extraction & Heuristics<br/>(Extract entry points via BFS depth 3 & append high-recall flags)"]
    EVID["3. Shared Evidence Bundle<br/>(Uniform payload: extracted code slices + heuristic context)"]

    subgraph DETECTORS[4. Parallel Detection Lanes]
        direction LR
        subgraph STATIC[Static Baselines]
            BAND["Bandit<br/>(Generic AST Linter)"]
            SEM["Semgrep<br/>(Offline Malware Rules)"]
            GD["GuardDog<br/>(Source-Only Scanner)"]
        end
        subgraph LLM[Single-Shot LLM Lanes]
            RAW["Raw LLM Mode<br/>(Source evidence only)"]
            HYB["Hybrid LLM Mode<br/>(Source + static findings + heuristics)"]
        end
    end

    CTRL["5. Detection Controller<br/>(Normalize JSON verdicts, log latency, & calculate API costs)"]
    DB[("6. Evaluation Database<br/>(Persist raw rows & compute package-version aggregations)")]

    ACQ --> EXTRACT --> EVID
    
    EVID --> STATIC
    EVID --> LLM
    
    STATIC --> CTRL
    LLM --> CTRL
    
    CTRL --> DB

    class ACQ,EXTRACT,EVID,CTRL service;
    class BAND,SEM,GD static;
    class RAW,HYB llm;
    class DB output;
